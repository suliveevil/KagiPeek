<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    The bundle's Info.plist for the swiftc build path.

    It lives in the repository because the fallback build used to read the template from
    /Applications/Kaname.app — a previously *installed* copy. That made the build depend on
    its own output: delete the app and nothing can be built, which is exactly what happened on
    2026-11-02. The values mirror the project settings (MARKETING_VERSION 2.3.0,
    CURRENT_PROJECT_VERSION 230, LSUIElement, minimum macOS 14.0); keep them in step when the
    version changes. The xcodebuild path does not read this file — it generates the plist from
    those same settings — so there is one source of truth per path and both are stated here.
-->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>zh-Hans</string>
	<key>CFBundleDisplayName</key>
	<string>Kaname</string>
	<key>CFBundleExecutable</key>
	<string>Kaname</string>
	<key>CFBundleIconFile</key>
	<string>Kaname</string>
	<key>CFBundleIconName</key>
	<string>Kaname</string>
	<key>CFBundleIdentifier</key>
	<string>com.suliveevil.kaname</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Kaname</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>2.3.0</string>
	<key>CFBundleVersion</key>
	<string>230</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string></string>
</dict>
</plist>
